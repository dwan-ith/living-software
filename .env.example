# Deterministic by default: no Gemini key is read and no Ollama/Gemma model is contacted.
MODEL_INFERENCE_ENABLED=false

# Dormant optional provider settings. They are ignored while inference is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_AGENT=antigravity-preview-05-2026

# Optional local provider settings; ignored while inference is disabled.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3n:e4b
# Optional semicolon-separated Windows binary candidates.
# OLLAMA_BINARY_CANDIDATES=C:\Users\you\AppData\Local\Programs\Ollama\ollama.exe;C:\Program Files\Ollama\ollama.exe

# Backend
PORT=3000
# Loopback by default: the runtime serves screenshots, clipboard access, and
# capability execution, so it must not bind to a LAN interface unattended.
BIND_HOST=127.0.0.1
# Semicolon-separated browser origins allowed to drive the runtime (HTTP + WS).
ALLOWED_ORIGINS=http://localhost:5173;http://127.0.0.1:5173;http://localhost:5174;http://127.0.0.1:5174
# Override the directory holding living-runtime.json, memory.json,
# surface-runtime.json, archives, and the effect journal (tests/parallel runs).
# LIVING_DATA_DIR=D:\somewhere\living-data
POWERSHELL_EXE=powershell.exe
OBSERVER_INTERVAL_MS=3500
OBSERVER_ANALYSIS_COOLDOWN_MS=15000
OBSERVER_FAILURE_BACKOFF_MS=300000
# Used only if model inference is explicitly enabled.
OBSERVER_PREFER_LOCAL_VISION=false
LIVING_AUTOSTART=true
LIVING_CYCLE_INTERVAL_MS=60000

# Frontend dev proxy
VITE_BACKEND_URL=http://127.0.0.1:3000
